# Copy to deploy/aws/.env and fill in. All scripts source this file. Nothing here is committed.
AWS_PROFILE=default
AWS_REGION=us-east-1
PROJECT=aurora-cdp
ENV_NAME=dev

# S3 raw landing bucket (globally unique)
RAW_BUCKET=aurora-cdp-raw-${ENV_NAME}-CHANGE-ME

# EC2 host running the compose stack
EC2_INSTANCE_TYPE=t3.large
EC2_KEY_NAME=CHANGE-ME            # existing EC2 key pair name
EC2_AMI_SSM=/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64
ALLOWED_CIDR=0.0.0.0/0            # tighten to your office / VPN CIDR
VPC_ID=                           # blank = default VPC
SUBNET_ID=                        # blank = first default subnet

# RDS Postgres (serving / metadata store)
RDS_IDENTIFIER=${PROJECT}-${ENV_NAME}
RDS_INSTANCE_CLASS=db.t3.micro
RDS_STORAGE_GB=20
RDS_DB_NAME=aurora
RDS_USERNAME=aurora
RDS_PASSWORD=CHANGE-ME-long-random
